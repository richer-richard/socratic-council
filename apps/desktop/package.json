{
  "name": "@socratic-council/desktop",
  "version": "3.0.0",
  "description": "Desktop application for Socratic Council - Tauri 2.0 + React",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm prepare:ocr && vite",
    "build": "pnpm prepare:ocr && pnpm -C ../../packages/shared build && pnpm -C ../../packages/core build && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run --root ../.. --config vitest.config.ts",
    "clean": "rm -rf dist",
    "prepare:ocr": "node ../../scripts/prepare-ocr-assets.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@noble/ciphers": "^2.4.0",
    "@socratic-council/core": "workspace:*",
    "@socratic-council/shared": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@xyflow/react": "^12.11.6",
    "docx": "^9.7.1",
    "fflate": "^0.8.3",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-metrics": "^2.4.2",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "katex": "^0.18.5",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.1.200",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.12",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.0"
  }
}
