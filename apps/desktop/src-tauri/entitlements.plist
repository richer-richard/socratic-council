<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- No App Sandbox. Inside it macOS will not let the shell tool start
         its own, much tighter sandbox (sandbox-exec: no network, writes only
         in the session workspace), and a shell run bare under the app's
         sandbox could reach the network and the app's keys. The app keeps
         the hardened runtime (tauri.conf.json), the webview keeps its strict
         CSP and no network of its own, and IPC is limited to the commands in
         capabilities/default.json. Every build up to 3.0.0 was sandboxed:
         src/data_move.rs copies that build's data out of its container on
         the first launch. -->
</dict>
</plist>
